# Channel data tool (the channel exporter). OFF by default: with the flag unset
# the exporter's UI and server routes are not built at all. Set it only for your
# own private local build, e.g.  VITE_ENABLE_CHANNEL_DATA=1 npm run dist:mac
# Never set it in the public release workflow.
VITE_ENABLE_CHANNEL_DATA=

# Devices that may see the tool in a build that has it. Comma-separated salted
# hashes, one per computer. Get this computer's hash with:  npm run machine-id
# A single * means any machine (a private build you do not share).
VITE_OWNER_MACHINES=

# Any long random string. Used to salt the machine hashes; keep it private.
VITE_OWNER_SALT=

# Where "Send report" posts a crash report: the https address of the report relay. Leave empty until
# the relay exists; with it empty, reports are kept on the computer and sent on a later launch.
VITE_REPORT_RELAY_URL=
