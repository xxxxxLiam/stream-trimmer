{
  "name": "clipr",
  "private": true,
  "description": "Cut short vertical clips out of long podcasts and interviews.",
  "author": "IDK Solutions (Pty) Ltd",
  "license": "SEE LICENSE IN LICENSE",
  "version": "19.6.0",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "postinstall": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "machine-id": "tsx scripts/machine-id.cjs",
    "build:mine": "tsx scripts/build-mine.cjs",
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx src/main/features/engine/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src",
    "test:renderer": "tsx --test \"src/renderer/**/*.test.ts\" \"src/renderer/**/*.test.tsx\"",
    "check": "npm run typecheck && npm test && npm run lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "tsx --test \"src/main/**/*.test.ts\" \"src/main/**/*.test.cjs\" \"src/preload/**/*.test.ts\" \"src/common/**/*.test.ts\" \"scripts/*.test.ts\" \"relay/**/*.test.ts\" \"src/renderer/**/*.test.ts\" \"src/renderer/**/*.test.tsx\"",
    "preview": "vite preview",
    "start": "concurrently -k -n web,server -c cyan,magenta \"npm:preview\" \"npm:dev:server\"",
    "dev:electron": "cross-env ELECTRON_DEV=1 CLIPR_DEV_BUILD=1 concurrently -k -n vite,server,electron -c cyan,magenta,yellow \"npm:dev:client\" \"npm:dev:server\" \"node scripts/build-main.cjs && wait-on http://localhost:8080 && electron out/main/index.cjs\"",
    "build:electron": "vite build && node scripts/bundle-binaries.cjs && node scripts/build-server.cjs && node scripts/build-main.cjs",
    "build:electron:dev": "cross-env CLIPR_DEV_BUILD=1 npm run build:electron",
    "dist:mac": "npm run build:electron && electron-builder --mac dmg",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "dist:linux": "npm run build:electron && electron-builder --linux AppImage",
    "release:mac": "npm run build:electron && electron-builder --mac dmg --publish always",
    "release:win": "npm run build:electron && electron-builder --win nsis --publish always",
    "release:linux": "npm run build:electron && electron-builder --linux AppImage --publish always",
    "release": "npm run build:electron && electron-builder -mwl --publish always",
    "parity": "node scripts/parity/parity.cjs",
    "parity:el": "node scripts/parity/elements.cjs",
    "build:relay": "node scripts/build-relay.cjs",
    "collect-sourcemaps": "node scripts/collect-sourcemaps.cjs",
    "decode-stack": "node scripts/decodeStack.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "youtube-dl-exec": "^3.0.10"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "express": "^4.21.0",
    "framer-motion": "^12.42.2",
    "javascript-obfuscator": "^5.10.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.1",
    "zod": "^3.23.8"
  },
  "build": {
    "appId": "app.youtubeclipper.local",
    "productName": "Clipr",
    "copyright": "Copyright © 2025–2026 IDK Solutions (Pty) Ltd",
    "artifactName": "Clipr-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "xxxxxLiam",
      "repo": "clipr",
      "releaseType": "draft"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/splash.html",
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "asar": true,
    "afterPack": "scripts/fuses.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Clipr-macOS-AppleSilicon.${ext}",
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "build/icon.icns",
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Clipr-Windows-x64-Setup.${ext}",
      "icon": "build/icon.ico",
      "sign": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Clipr-Linux-x64.${ext}",
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  },
  "productName": "Clipr"
}
